# ---------------------------------------------------------------------------
# Cluetune environment
#
# Everything here is OPTIONAL. With no keys at all the site still runs:
# autocomplete and preview clips both fall back to keyless public endpoints.
# ---------------------------------------------------------------------------

# Spotify — metadata AND a wider Unlimited pool, *if your app can call the API*.
#
# Many newly created Spotify apps now get 403 on search and playlists unless
# the developer account has Spotify Premium ("Active premium subscription
# required for the owner of the app"). Token exchange can still succeed.
#
# Cluetune does not depend on that. Unlimited already widens from iTunes and
# Deezer charts (no key). Spotify, when it works, adds titles, artwork, ISRC
# and editorial playlists.
#
# Spotify does NOT provide playable audio. `preview_url` was withdrawn from
# the Web API on 2024-11-27. Clips come from Apple Music and Deezer previews.
#
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 — used to attach a full-track embed to the reveal screen.
#
# Deliberately NOT used for clip audio: the IFrame Player terms require a
# visible, unobscured player, which would show the answer. See
# src/lib/providers/youtube.ts for the full reasoning.
#
# Create a key at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Escape hatch that allows YouTube to serve clip audio when no licensed preview
# exists. Off by default. Turning this on is a legal decision, not a technical
# one — read the note in src/lib/providers/youtube.ts first.
ALLOW_YOUTUBE_CLIP_FALLBACK=false
