---
import GameShell from "../components/game/GameShell";
import MeshGradient from "../components/MeshGradient.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Lyric-Flip"
  description="A scrambled, redacted hook alongside the audio clip. Two routes to the same answer — read it or hear it."
>
  <section class="relative isolate">
    <MeshGradient intensity="soft" />

    <div class="page-shell relative py-12 sm:py-16">
      <header class="mx-auto flex max-w-2xl flex-col items-center gap-3 text-center">
        <p class="eyebrow">Lyric-flip</p>
        <h1 class="text-display-xl text-ink">Read it, hear it, or both.</h1>
        <p class="max-w-lg text-body-md text-body">
          The hook is scrambled and redacted alongside the clip. Every wrong guess un-redacts a
          little more — word order first, then vowels, then initials. Two routes to the same answer.
        </p>
      </header>

      <div class="mx-auto mt-10 max-w-2xl">
        <GameShell client:load mode="lyric-flip" continuous showFilters />
      </div>
    </div>
  </section>
</Layout>
