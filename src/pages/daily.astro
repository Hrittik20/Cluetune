---
import GameShell from "../components/game/GameShell";
import MeshGradient from "../components/MeshGradient.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Daily Challenge"
  description="One clip a day, the same for everyone, reset at your local midnight. Six attempts, no account needed."
>
  <section class="relative isolate">
    <MeshGradient intensity="soft" />

    <div class="page-shell relative py-12 sm:py-16">
      <header class="mx-auto flex max-w-2xl flex-col items-center gap-3 text-center">
        <p class="eyebrow">Daily challenge</p>
        <h1 class="text-display-xl text-ink">One clip. Everyone gets the same one.</h1>
        <p class="max-w-lg text-body-md text-body">
          Resets at midnight where you are. Miss a day and the streak resets — that is the only
          pressure this mode applies.
        </p>
      </header>

      <div class="mx-auto mt-10 max-w-2xl">
        <GameShell client:load mode="daily" />
      </div>

      <p class="mx-auto mt-10 max-w-md text-center text-body-sm text-mute">
        Done for the day? <a href="/" class="text-link underline underline-offset-4">Unlimited</a> has no
        cooldown.
      </p>
    </div>
  </section>
</Layout>
