---
import { SITE } from "../consts";

export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=1200" />
    <title>Cluetune OG</title>
    <style>
      html,
      body {
        margin: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
        background: #08080a;
        color: #fafafa;
        font-family: Geist, Inter, ui-sans-serif, system-ui, sans-serif;
      }
      .frame {
        position: relative;
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }
      .record {
        position: absolute;
        left: 710px;
        top: 15px;
        width: 600px;
        height: 600px;
        border-radius: 50%;
        background: repeating-radial-gradient(
          circle,
          #121215 0 10px,
          rgb(255 255 255 / 0.05) 10px 11.5px
        );
      }
      .record::before {
        content: "";
        position: absolute;
        inset: 204px;
        border-radius: 50%;
        background: #efe7d6;
        box-shadow: inset 0 0 0 18px #efe7d6, inset 0 0 0 19.5px rgb(24 24 27 / 0.22);
      }
      .record::after {
        content: "";
        position: absolute;
        inset: 294px;
        border-radius: 50%;
        background: #08080a;
      }
      .sticker {
        position: absolute;
        left: 784px;
        top: 92px;
        transform: rotate(7deg);
        transform-origin: top left;
        padding: 4px;
        border-radius: 14px;
        background: #fff;
      }
      .sticker span {
        display: block;
        width: 168px;
        padding: 12px 0 10px;
        border-radius: 11px;
        background: #e5484d;
        text-align: center;
        line-height: 1;
      }
      .sticker small {
        display: block;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.1em;
        opacity: 0.8;
      }
      .sticker b {
        display: block;
        margin-top: 6px;
        font-size: 28px;
      }
      .copy {
        position: relative;
        z-index: 1;
        height: 100%;
        display: flex;
        flex-direction: column;
        padding: 88px;
        box-sizing: border-box;
      }
      .mark {
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 28px;
        font-weight: 500;
      }
      h1 {
        margin: 64px 0 0;
        font-size: 72px;
        line-height: 1.05;
        letter-spacing: -0.03em;
        font-weight: 500;
        max-width: 11ch;
      }
      p {
        margin: 24px 0 0;
        font-size: 26px;
        line-height: 1.45;
        color: #a1a1ac;
        max-width: 22ch;
      }
      .url {
        margin-top: auto;
        font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 18px;
        color: #85858f;
      }
    </style>
  </head>
  <body>
    <div class="frame">
      <div class="record"></div>
      <div class="sticker"><span><small>DIFFICULTY</small><b>EXPERT</b></span></div>
      <div class="copy">
        <div class="mark">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true">
            <circle cx="18" cy="18" r="17" fill="#fafafa"></circle>
            <circle cx="18" cy="18" r="12.5" stroke="#08080a" stroke-opacity="0.35"></circle>
            <circle cx="18" cy="18" r="7" fill="#08080a"></circle>
            <circle cx="18" cy="18" r="2" fill="#fafafa"></circle>
          </svg>
          <span>Cluetune</span>
        </div>
        <h1>Guess the song from 1 second</h1>
        <p>Daily puzzle, then unlimited rounds. Free, in the browser, no account.</p>
        <p class="url">{SITE.domain}</p>
      </div>
    </div>
  </body>
</html>
