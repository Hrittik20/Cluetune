---
import { LOCALE_CODES, localizedPath, type LocaleCode } from "../../i18n/config";

export function getStaticPaths() {
  return LOCALE_CODES.filter((code) => code !== "en").map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as LocaleCode;
const target = localizedPath(lang, "/drunk");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Redirecting…</title>
  </head>
  <body>
    <p><a href={target}>Continue to Drunk</a></p>
  </body>
</html>
