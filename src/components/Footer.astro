---
import { SITE } from "../consts";

const columns = [
  {
    title: "Play",
    links: [
      { href: "/", label: "Unlimited" },
      { href: "/daily", label: "Daily challenge" },
      { href: "/sped-up", label: "Sped-Up round" },
      { href: "/lyric-flip", label: "Lyric-Flip" },
      { href: "/gauntlet", label: "Genre Gauntlet" },
    ],
  },
  {
    title: "Your game",
    links: [
      { href: "/stats", label: "Stats & streaks" },
      { href: "/how-to-play", label: "How to play" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="hairline-t mt-24 bg-canvas-soft">
  <div class="page-shell-wide grid gap-10 py-16 sm:grid-cols-2 md:grid-cols-4">
    <div class="flex flex-col gap-3">
      <p class="text-display-sm text-ink" translate="no">Cluetune</p>
      <p class="max-w-64 text-body-sm text-body">{SITE.tagline}</p>
    </div>

    {
      columns.map((column) => (
        <nav class="flex flex-col gap-3" aria-label={column.title}>
          <p class="eyebrow">{column.title}</p>
          <ul class="flex flex-col gap-2">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="rounded-xs text-body-sm text-body hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div class="flex flex-col gap-3">
      <p class="eyebrow">Audio</p>
      <p class="text-caption text-mute">
        Clips are streamed from the rights holders’ own preview services. Cluetune does not host,
        cache or re-serve any audio.
      </p>
    </div>
  </div>

  <div class="page-shell-wide hairline-t flex flex-wrap items-center justify-between gap-3 py-6">
    <p class="text-caption text-mute">© {year} {SITE.domain}</p>
    <p class="text-caption text-mute">Track metadata via Spotify · previews via Apple Music & Deezer</p>
  </div>
</footer>
