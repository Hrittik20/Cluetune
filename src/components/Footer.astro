---
import { SITE } from "../consts";

const columns = [
  {
    title: "Play",
    links: [
      { href: "/", label: "Daily challenge" },
      { href: "/unlimited", label: "Unlimited" },
      { href: "/sped-up", label: "Sped-Up round" },
      { href: "/lyrics", label: "Lyrics Guess" },
      { href: "/gauntlet", label: "Genre Gauntlet" },
    ],
  },
  {
    title: "Your game",
    links: [
      { href: "/stats", label: "Stats & streaks" },
      { href: "/how-to-play", label: "How to play" },
    ],
  },
  {
    title: "Site",
    links: [
      { href: "/about", label: "About us" },
      { href: "/contact", label: "Contact us" },
      { href: "/privacy", label: "Privacy policy" },
      { href: "/terms", label: "Terms & conditions" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="hairline-t mt-12 bg-canvas-soft pb-[calc(5.25rem+env(safe-area-inset-bottom,0px))] md:mt-24 md:pb-0">
  <div class="page-shell-wide grid gap-8 py-10 sm:grid-cols-2 md:grid-cols-4 md:gap-10 md:py-16">
    <div class="flex flex-col gap-3">
      <p class="text-display-sm text-ink" translate="no">Cluetune</p>
      <p class="max-w-64 text-body-sm text-body">{SITE.tagline}</p>
    </div>

    {
      columns.map((column) => (
        <nav class="flex flex-col gap-3" aria-label={column.title}>
          <p class="eyebrow">{column.title}</p>
          <ul class="flex flex-col gap-2">
            {column.links.map((link) => (
              <li>
                <a href={link.href} class="rounded-xs text-body-sm text-body hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="page-shell-wide hairline-t flex flex-wrap items-center justify-between gap-3 py-5 md:py-6">
    <p class="text-caption text-mute">© {year} {SITE.domain}</p>
    <p class="text-caption text-mute">Charts via Apple Music & Deezer · metadata via Spotify when available</p>
  </div>
</footer>
