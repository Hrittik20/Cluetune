---
interface Props {
  href: string;
  name: string;
  blurb: string;
  meta: string;
  featured?: boolean;
}

const { href, name, blurb, meta, featured = false } = Astro.props;
const isDrunk = href.replace(/\/$/, "").endsWith("/drunk");
---

<a
  href={href}
  class:list={[
    "group flex flex-col gap-3 rounded-lg p-5 transition-colors duration-150 hover:bg-surface-raised sm:p-6",
    featured ? "card-raised sm:col-span-2" : "card",
  ]}
>
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="text-display-sm text-ink">
      <span class:list={[isDrunk && "label-drunk"]}>{name}</span>
    </h3>
    <span class="eyebrow shrink-0">{meta}</span>
  </div>

  <p class="text-body-sm text-body">{blurb}</p>

  <span class="mt-auto inline-flex items-center gap-2 pt-1 text-body-sm text-ink">
    Play
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
      class="transition-transform duration-150 group-hover:translate-x-0.5"
    >
      <path
        d="M5 12h14m-6-6 6 6-6 6"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>
