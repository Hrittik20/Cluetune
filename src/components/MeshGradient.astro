---
/**
 * Brand mesh without filter:blur — soft radial stops only.
 * Blurred layers were delaying desktop and mobile LCP under PageSpeed.
 */
interface Props {
  /** Dials the whole mesh back on denser surfaces. */
  intensity?: "full" | "soft";
  class?: string;
}

const { intensity = "full", class: className = "" } = Astro.props;
const opacity = intensity === "full" ? 0.55 : 0.32;
---

<div
  class:list={["pointer-events-none absolute inset-0 overflow-hidden", className]}
  aria-hidden="true"
  style={`--mesh-opacity: ${opacity}`}
>
  <div class="mesh-static"></div>
  <div class="mesh-veil"></div>
</div>

<style>
  .mesh-static {
    position: absolute;
    inset: 0;
    opacity: var(--mesh-opacity);
    background:
      radial-gradient(ellipse 80% 55% at 15% 20%, #007cf0 0%, transparent 55%),
      radial-gradient(ellipse 70% 50% at 85% 15%, #00dfd8 0%, transparent 50%),
      radial-gradient(ellipse 75% 60% at 30% 90%, #7928ca 0%, transparent 55%),
      radial-gradient(ellipse 65% 45% at 90% 80%, #ff0080 0%, transparent 50%);
  }

  .mesh-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 100% 62% at 50% 0%, transparent 0%, var(--cluetune-canvas) 72%),
      linear-gradient(to bottom, transparent 0%, var(--cluetune-canvas) 92%);
  }
</style>
