---
import { NAV_ITEMS, SITE } from "../consts";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="sticky top-0 z-40 hairline-b bg-canvas/85 backdrop-blur-md">
  <div class="page-shell-wide flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 rounded-md text-display-sm text-ink"
      aria-label={`${SITE.name} home`}
    >
      <span aria-hidden="true" class="relative grid size-7 place-items-center">
        <span class="absolute inset-0 rounded-full bg-linear-135 from-[#007cf0] via-[#7928ca] to-[#ff0080]"></span>
        <span class="absolute inset-[6px] rounded-full bg-canvas"></span>
        <span class="absolute inset-[11px] rounded-full bg-ink"></span>
      </span>
      <span translate="no">Cluetune</span>
    </a>

    <nav aria-label="Game modes" class="min-w-0 flex-1">
      <ul class="flex items-center gap-1 overflow-x-auto [scrollbar-width:none] sm:justify-center">
        {
          NAV_ITEMS.map((item) => {
            const active = item.href === "/" ? path === "/" : path.startsWith(item.href);
            return (
              <li class="shrink-0">
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "block rounded-full px-3 py-2 text-body-sm transition-colors duration-150",
                    active ? "bg-canvas-soft-2 text-ink" : "text-body hover:text-ink",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <a href="/stats" class="btn btn-ghost btn-sm hidden sm:inline-flex">Stats</a>
      <button
        type="button"
        id="theme-toggle"
        class="btn btn-secondary btn-icon"
        aria-label="Switch to light theme"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          data-theme-icon="dark"
        >
          <path
            d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"></path>
        </svg>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          data-theme-icon="light"
          class="hidden"
        >
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"></circle>
          <path
            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("theme-toggle");

  const syncIcons = (theme: string) => {
    document.querySelectorAll<SVGElement>("[data-theme-icon]").forEach((icon) => {
      icon.classList.toggle("hidden", icon.dataset.themeIcon !== theme);
    });
    toggle?.setAttribute(
      "aria-label",
      theme === "dark" ? "Switch to light theme" : "Switch to dark theme",
    );
  };

  syncIcons(document.documentElement.dataset.theme ?? "dark");

  toggle?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", next === "dark" ? "#08080a" : "#ffffff");

    try {
      localStorage.setItem("cluetune:theme", next);
    } catch {
      /* Private mode: the toggle still works for this session. */
    }

    syncIcons(next);
  });
</script>
