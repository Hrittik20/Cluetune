---
import { NAV_ITEMS, SITE } from "../consts";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const ICONS: Record<string, string> = {
  "/": "M12 3 4 9v12h5v-7h6v7h5V9L12 3Z",
  "/unlimited": "M18.6 6.4a7 7 0 0 0-9.9 0L7 8.1m-1.6 9.5a7 7 0 0 0 9.9 0L17 15.9M4 8.1h4V4M20 15.9h-4V20",
  "/sped-up": "m13 3-9 11h8l-1 7 9-11h-8l1-7Z",
  "/lyrics": "M7 4h10M7 9h10M7 14h6M5 20h14a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1Z",
  "/gauntlet": "M8 21V8m4 13V3m4 18v-9",
};
---

<header class="sticky top-0 z-40 hairline-b bg-canvas/85 backdrop-blur-md">
  <div class="page-shell-wide flex h-14 items-center justify-between gap-3 md:h-16 md:gap-4">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 rounded-md text-display-sm text-ink"
      aria-label={`${SITE.name} home`}
    >
      <span aria-hidden="true" class="relative grid size-7 place-items-center">
        <span class="absolute inset-0 rounded-full bg-linear-135 from-[#007cf0] via-[#7928ca] to-[#ff0080]"></span>
        <span class="absolute inset-[6px] rounded-full bg-canvas"></span>
        <span class="absolute inset-[11px] rounded-full bg-ink"></span>
      </span>
      <span translate="no">Cluetune</span>
    </a>

    <nav aria-label="Game modes" class="hidden min-w-0 flex-1 md:block">
      <ul class="flex items-center justify-center gap-1">
        {
          NAV_ITEMS.map((item) => {
            const active = item.href === "/" ? path === "/" : path.startsWith(item.href);
            return (
              <li class="shrink-0">
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "block rounded-full px-3 py-2 text-body-sm transition-colors duration-150",
                    active ? "bg-canvas-soft-2 text-ink" : "text-body hover:text-ink",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
      <a href="/stats" class="btn btn-ghost btn-sm">Stats</a>
      <button
        type="button"
        id="theme-toggle"
        class="btn btn-secondary btn-icon"
        aria-label="Switch to light theme"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          data-theme-icon="dark"
        >
          <path
            d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
            stroke="currentColor"
            stroke-width="2"
            stroke-linejoin="round"></path>
        </svg>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          data-theme-icon="light"
          class="hidden"
        >
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"></circle>
          <path
            d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<nav
  aria-label="Game modes"
  class="fixed inset-x-0 bottom-0 z-40 hairline-t bg-canvas/92 backdrop-blur-md md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom, 0px)"
>
  <ul class="grid grid-cols-5">
    {
      NAV_ITEMS.map((item) => {
        const active = item.href === "/" ? path === "/" : path.startsWith(item.href);
        const icon = ICONS[item.href] ?? ICONS["/"]!;
        return (
          <li>
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex min-h-12 flex-col items-center justify-center gap-0.5 px-1 py-1.5 text-[11px] leading-none",
                active ? "text-ink" : "text-mute",
              ]}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d={icon}
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<script>
  const toggle = document.getElementById("theme-toggle");

  const syncIcons = (theme: string) => {
    document.querySelectorAll<SVGElement>("[data-theme-icon]").forEach((icon) => {
      icon.classList.toggle("hidden", icon.dataset.themeIcon !== theme);
    });
    toggle?.setAttribute(
      "aria-label",
      theme === "dark" ? "Switch to light theme" : "Switch to dark theme",
    );
  };

  syncIcons(document.documentElement.dataset.theme ?? "dark");

  toggle?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", next === "dark" ? "#08080a" : "#ffffff");

    try {
      localStorage.setItem("cluetune:theme", next);
    } catch {
      /* Private mode: the toggle still works for this session. */
    }

    syncIcons(next);
  });
</script>
