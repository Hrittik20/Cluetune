---
/**
 * Warm the round API. Desktop starts immediately (helps LCP after hydrate);
 * mobile waits until load/idle so Slow-4G bandwidth stays free for CSS/fonts.
 */
interface Props {
  mode?: string;
  count?: number;
}

const { mode = "daily", count = mode === "daily" ? 1 : 3 } = Astro.props;
---

<script is:inline define:vars={{ mode, count }}>
  (function () {
    var d = new Date();
    var key =
      d.getFullYear() +
      "-" +
      String(d.getMonth() + 1).padStart(2, "0") +
      "-" +
      String(d.getDate()).padStart(2, "0");
    window.__CLUETUNE_DATE__ = key;

    var start = function () {
      if (window.__CLUETUNE_ROUND__) return;
      var params = new URLSearchParams({ mode: mode, count: String(count) });
      if (mode === "daily") params.set("date", key);
      var url = "/api/round?" + params.toString();
      var promise = fetch(url, { credentials: "same-origin" }).then(function (response) {
        return response.json();
      });
      window.__CLUETUNE_ROUND__ = { mode: mode, date: key, promise: promise };
    };

    var desktop = false;
    try {
      desktop = window.matchMedia("(min-width: 768px)").matches;
    } catch (e) {}

    if (desktop) {
      start();
      return;
    }

    if (document.readyState === "complete") {
      if ("requestIdleCallback" in window) requestIdleCallback(start, { timeout: 1200 });
      else setTimeout(start, 200);
    } else {
      window.addEventListener("load", function () {
        if ("requestIdleCallback" in window) requestIdleCallback(start, { timeout: 1200 });
        else setTimeout(start, 200);
      });
    }
  })();
</script>
