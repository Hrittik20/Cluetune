---
/**
 * Starts the round request while the page is still parsing so the game island
 * can pick it up on hydrate. It must start before the island hydrates on every
 * viewport: a late start makes the island fetch on its own and the prefetch
 * then fires a second, wasted request against the audio providers.
 */
interface Props {
  mode?: string;
  count?: number;
}

const { mode = "daily", count = mode === "daily" ? 1 : 3 } = Astro.props;
---

<script is:inline define:vars={{ mode, count }}>
  (function () {
    var d = new Date();
    var key =
      d.getFullYear() +
      "-" +
      String(d.getMonth() + 1).padStart(2, "0") +
      "-" +
      String(d.getDate()).padStart(2, "0");
    window.__CLUETUNE_DATE__ = key;

    if (window.__CLUETUNE_ROUND__) return;
    var params = new URLSearchParams({ mode: mode, count: String(count) });
    if (mode === "daily") params.set("date", key);
    var promise = fetch("/api/round?" + params.toString(), { credentials: "same-origin" }).then(
      function (response) {
        return response.json().then(function (data) {
          if (!response.ok && !data.error) data.error = "Could not load a round.";
          return data;
        });
      },
    );
    window.__CLUETUNE_ROUND__ = { mode: mode, date: key, promise: promise };
  })();
</script>
