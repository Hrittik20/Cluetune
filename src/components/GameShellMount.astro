---
/**
 * A single island for every viewport. Rendering one copy per breakpoint doubled
 * the SSR DOM and the style/layout work on phones.
 */
import GameShell from "./game/GameShell";
import type { GameMode } from "../lib/types";

interface Props {
  mode: GameMode;
  continuous?: boolean;
  showFilters?: boolean;
  pack?: string;
  packName?: string;
  lockedTrackId?: string;
  challengerAttempt?: number;
  challengerSeconds?: number;
  challengerName?: string;
}

const props = Astro.props;
---

<GameShell client:load {...props} />
